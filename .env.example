# Public values only. These three reach the browser; that is safe by design.
# Leave them empty to run the site in demo mode (an in-browser database with sample data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://gangasagar.pages.dev

# Optional, public: Cloudflare Turnstile site key (spam protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Secrets: NEVER put these in this file or in Cloudflare Pages. ---
# They live only in Supabase (Edge Function secrets) and GitHub (Actions secrets):
#   TURNSTILE_SECRET_KEY      -> Supabase Edge Function secret
#   RESEND_API_KEY            -> Supabase Edge Function secret
#   CF_DEPLOY_HOOK_URL        -> Supabase Edge Function secret (Publish button)
#   SUPABASE_DB_URL           -> GitHub Actions secret (nightly backup)
#   BACKUP_REPO_TOKEN         -> GitHub Actions secret (nightly backup)
